          "group": "模块注入",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "动态库导出入口执行函数名称"
        },
        {
          "name": "data",
          "display_name": "初始化数据",
          "intrinsic_type": "String",
          "group": "模块注入",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "传递给入口函数的初始化配置或载荷字符串"
