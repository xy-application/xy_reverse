{
  "plugin_id": "xy_reverse",
  "name": "底层调试与内存分析探针 (Native Debug & Memory Inspector)",
  "version": "0.54.0",
  "group": "Reverse",
  "group_icon": "🔬",
  "description": "提供进程注入挂载、导出函数远程调用、系统句柄释放、虚拟/物理DMA内存读写与特征码扫描等专家级底层逆向与诊断能力",
  "compliance_level": "Expert-Diagnostics",
  "actions": [
    {
      "tag": "AttachProcess",
      "display_name": "附加与模块注入 (AttachProcess)",
      "icon": "📎",
      "platforms": "All",
      "requires_admin": true,
      "description": "连接并附加到目标软件进程，支持动态加载扩展模块与执行初始化逻辑",
      "keywords": [
        "reverse",
        "debug",
        "process",
        "attach",
        "inject",
        "hook",
        "附加进程",
        "进程注入",
        "动态库"
      ],
      "fields": [
        {
          "name": "app",
          "display_name": "目标进程",
          "intrinsic_type": "String",
          "required": true,
          "group": "目标进程",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "目标进程名称、PID 或完整路径"
        },
        {
          "name": "dy",
          "display_name": "模块动态库",
